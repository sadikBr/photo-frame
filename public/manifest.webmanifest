{
  "id": "/admin",
  "name": "لوحة العائلة",
  "short_name": "الإطار",
  "description": "تحكّم في إطار العائلة وأرسل إليه نبضة: الرسائل، القوائم، الصور، المناسبات ومواقيت الصلاة.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#2A0D1B",
  "theme_color": "#2A0D1B",
  "categories": [
    "lifestyle",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "brand/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "brand/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "brand/screenshot-panel.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "لوحة التحكم على الهاتف"
    },
    {
      "src": "brand/screenshot-frame.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "شاشة الإطار"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "أرسل نبضة",
      "short_name": "نبضة",
      "description": "قلب، رسمة أو رسالة صوتية إلى الإطار",
      "url": "/admin#pulse",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "قائمة المشتريات",
      "short_name": "المشتريات",
      "url": "/admin#lists",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
